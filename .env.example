# Local Docker Compose defaults for development only. Replace before any shared deployment.
POSTGRES_DB=hazard_demo
POSTGRES_USER=hazard_demo
POSTGRES_PASSWORD=hazard_demo

# For services running directly on this machine, not inside Compose.
DATABASE_URL=postgresql://hazard_demo:hazard_demo@localhost:5432/hazard_demo
HAZARD_ENGINE_URL=http://127.0.0.1:8000/hazard-sim
HAZARD_SITE_ORIGIN_LAT=19.0000
HAZARD_SITE_ORIGIN_LON=72.0000
HAZARD_STALE_TIMEOUT_SECONDS=10
